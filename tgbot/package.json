{
  "name": "amsat-status-tgbot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram bot for submitting AMSAT satellite status reports, running on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "set-webhook": "node scripts/set-webhook.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250801.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.90.0"
  }
}
